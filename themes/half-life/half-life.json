        "brand-fill": "#f27a11",
        "brand-fill-hover": "#ff8d29",
        "brand-fill-active": "#e06d06",
        "content-on-brand": "#0d0e10",
        "content-on-accent": "#0d0e10",
        "selected-bg": 0.16,
        "selected-border": 0.45,
        "selected-ink": "#ffa952",
        "focus-ring": 0.65,
        "ai": "#4fd1c5",
        "ai-hover": "#76e4f7",
