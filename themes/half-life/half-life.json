        "foreground": "#e6e1d8",
        "cursor": "#fb8b24",
        "selection": "#4a2c11",
        "ansi": [
          "#36393f",
          "#ff6b63",
          "#65cf78",
          "#f5b027",
          "#58a6ff",
          "#c98eff",
          "#3dd6d0",
          "#c7c2b8",
          "#7d828c",
          "#ff8b85",
          "#7ee28f",
          "#ffca57",
          "#7ec0ff",
          "#dab0ff",
          "#66e8e3",
          "#f7f5f0"
        ]
      },
      "syntax": {
        "tokens": {
          "foreground": "#e6e1d8",
          "comment": {
            "color": "#8c929c",
            "font_style": "italic"
          },
          "keyword": "#fb8b24",
          "keyword.control": "#ff9e42",
          "string": "#7ee28f",
          "number": "#ffca57",
          "function": "#ffb86c",
          "type": "#66e8e3",
          "variable": "#e6e1d8",
          "variable.parameter": "#f5c281",
          "property": "#9ecbff",
          "constant": "#ff8b85",
          "tag": "#fb8b24",
          "punctuation": "#a8aeb8",
          "operator": "#ff9e42"
        }
      }
    },
    {
