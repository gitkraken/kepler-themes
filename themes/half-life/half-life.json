{
  "$schema": "https://kepler.gitkraken.com/schemas/theme-family.json",
  "schemaVersion": 2,
  "name": "Half-Life",
  "version": "1.0.0",
  "author": "cprusso1707",
  "description": "Industrial gunmetal, clinical lab surfaces, and iconic HEV Lambda orange inspired by Half-Life.",
  "license": "MIT",
  "themes": [
    {
      "id": "half-life-hev-dark",
      "name": "Half-Life: HEV Suit (Dark)",
      "extends": "dark",
      "colors": {
        "surface-sunken": "#111214",
        "surface-canvas": "#17181b",
        "surface-raised": "#1f2125",
        "surface-overlay": "#272a2f",
        "field": "#17181b",
        "ink": "#f2efe9",
        "content-strong": "#f7f5f0",
        "content": 0.88,
        "content-muted": 0.72,
        "content-subtle": 0.6,
        "brand": "#fb8b24",
